// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @db.VarChar(21)
  name            String   @db.VarChar(255)
  email           String   @unique @db.VarChar(255)
  username        String   @unique @db.VarChar(50)
  password        String   @db.Text
  profile_picture String?  @db.Text
  header_picture  String?  @db.Text
  isverified      Boolean  @default(false)
  token           String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)

  posts                  Post[]
  likes                  Like[]
  comments               Comment[]
  conversation_members   ConversationMember[]
  sent_messages          Message[]            @relation("SentMessages")
  following              Follow[]             @relation("FollowerRelation")
  followers              Follow[]             @relation("FollowingRelation")
  received_notifications Notification[]       @relation("NotificationRecipient")
  acted_notifications    Notification[]       @relation("NotificationActor")
  saved_posts            SavedPost[]
  wallet                 Wallet?
  wallet_transactions    WalletTransaction[]
  sent_tips              Tip[]                @relation("SentTips")
  received_tips          Tip[]                @relation("ReceivedTips")
  post_purchases         PostPurchase[]
  refresh_tokens         RefreshToken[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Post {
  id                   String   @id @db.VarChar(21)
  user_id              String   @db.VarChar(21)
  content              String   @db.Text
  media_url            String?  @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)
  media_urls           Json?    @db.JsonB
  media_fileids        Json?    @db.JsonB
  is_follower_only     Boolean  @default(false)
  hidden_content       String?  @db.Text
  hidden_media_urls    Json?    @db.JsonB
  hidden_media_fileids Json?    @db.JsonB
  is_paid              Boolean  @default(false)
  price                Int?
  comments_disabled    Boolean  @default(false)

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  likes          Like[]
  comments       Comment[]
  saved_posts    SavedPost[]
  tips           Tip[]
  post_purchases PostPurchase[]

  @@index([user_id])
  @@index([created_at])
  @@map("posts")
}

model Like {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.VarChar(21)
  post_id    String   @db.VarChar(21)
  created_at DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id], map: "unique_user_post_like")
  @@index([user_id])
  @@index([post_id])
  @@map("likes")
}

model Comment {
  id         String   @id @db.VarChar(21)
  user_id    String   @db.VarChar(21)
  post_id    String   @db.VarChar(21)
  content    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([post_id])
  @@index([created_at])
  @@map("comments")
}

model Conversation {
  id         String   @id @db.VarChar(21)
  created_at DateTime @default(now()) @db.Timestamp(6)

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  conversation_id String @db.VarChar(21)
  user_id         String @db.VarChar(21)

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, user_id], map: "conversation_members_pkey")
  @@index([user_id])
  @@map("conversation_members")
}

model Message {
  id              String   @id @db.VarChar(21)
  conversation_id String   @db.VarChar(21)
  sender_id       String   @db.VarChar(21)
  content         String?  @db.Text
  media_url       String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(6)

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([sender_id])
  @@map("messages")
}

model Follow {
  id           String   @id @db.VarChar(21)
  follower_id  String   @db.VarChar(21)
  following_id String   @db.VarChar(21)
  created_at   DateTime @default(now()) @db.Timestamp(6)

  follower  User @relation("FollowerRelation", fields: [follower_id], references: [id], onDelete: Cascade)
  following User @relation("FollowingRelation", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id], map: "unique_follow")
  @@index([follower_id])
  @@index([following_id])
  @@map("follows")
}

model Notification {
  id           String   @id @db.VarChar(21)
  recipient_id String   @db.VarChar(21)
  actor_id     String   @db.VarChar(21)
  type         String   @db.VarChar(20)
  entity_id    String?  @db.VarChar(21)
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamp(6)

  recipient User @relation("NotificationRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  actor     User @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([recipient_id])
  @@index([recipient_id, is_read])
  @@map("notifications")
}

model SavedPost {
  user_id    String   @db.VarChar(21)
  post_id    String   @db.VarChar(21)
  created_at DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([user_id, post_id], map: "saved_posts_pkey")
  @@map("saved_posts")
}

model Wallet {
  id         String   @id @db.VarChar(21)
  user_id    String   @unique @db.VarChar(21)
  balance    BigInt   @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("wallets")
}

model WalletTransaction {
  id                      String   @id @db.VarChar(21)
  user_id                 String   @db.VarChar(21)
  type                    String   @db.VarChar(20)
  amount                  BigInt
  status                  String   @default("pending") @db.VarChar(20)
  midtrans_order_id       String?  @unique @db.VarChar(100)
  midtrans_transaction_id String?  @db.VarChar(100)
  payment_type            String?  @db.VarChar(50)
  snap_token              String?  @db.Text
  snap_redirect_url       String?  @db.Text
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([midtrans_order_id])
  @@index([status])
  @@map("wallet_transactions")
}

model Tip {
  id          String   @id @db.VarChar(21)
  sender_id   String   @db.VarChar(21)
  receiver_id String   @db.VarChar(21)
  post_id     String   @db.VarChar(21)
  amount      BigInt
  message     String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)

  sender   User @relation("SentTips", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedTips", fields: [receiver_id], references: [id], onDelete: Cascade)
  post     Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([sender_id])
  @@index([receiver_id])
  @@index([post_id])
  @@index([created_at])
  @@map("tips")
}

model PostPurchase {
  id         String   @id @db.VarChar(21)
  user_id    String   @db.VarChar(21)
  post_id    String   @db.VarChar(21)
  amount     Int
  created_at DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id], map: "unique_user_post_purchase")
  @@index([user_id])
  @@index([post_id])
  @@map("post_purchases")
}

model RefreshToken {
  id         String   @id @db.VarChar(21)
  user_id    String   @db.VarChar(21)
  token      String   @unique @db.Text
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
  @@map("refresh_tokens")
}
