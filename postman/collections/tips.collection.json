{
  "info": {
    "_postman_id": "chatter-tips-collection",
    "name": "Chatter - Tips API",
    "description": "Tips endpoints: Send Tip, Get Tips Activity.\nAll require authentication. Only success (200/201) test cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Send Tip",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[Send Tip] Sending tip to post:', pm.environment.get('test_post_id'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has tip data', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('data');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{auth_token}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"post_id\": \"{{test_post_id}}\",\n  \"amount\": 5000,\n  \"message\": \"Great post! Here is a tip from Postman.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/tips",
          "host": ["{{base_url}}"],
          "path": ["api", "tips"]
        }
      }
    },
    {
      "name": "Get Tips Activity",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[Get Tips Activity] Fetching tips activity');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has tips data', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('data');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{auth_token}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/tips/activity?page=1&limit=20",
          "host": ["{{base_url}}"],
          "path": ["api", "tips", "activity"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    }
  ]
}
