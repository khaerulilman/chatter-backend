    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[Login] Using email:', pm.environment.get('test_email'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has token and user data', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('token');",
              "    pm.expect(body).to.have.property('user');",
              "    pm.expect(body.user).to.have.property('id');",
              "});",
              "",
              "const body = pm.response.json();",
              "if (body.token) {",
              "    pm.environment.set('auth_token', body.token);",
              "    console.log('[Login] Saved auth_token');",
              "}",
              "if (body.user) {",
              "    pm.environment.set('user_id', body.user.id);",
              "    pm.environment.set('user_name', body.user.username || body.user.name);",
              "    console.log('[Login] Saved user_id:', body.user.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
