{
  "info": {
    "_postman_id": "chatter-posts-collection",
    "name": "Chatter - Posts API",
    "description": "Posts endpoints: Get All Posts, Get Posts By User ID, Create Post, Get Post By ID, Delete Post, Toggle Like, Get Like Status, Get Like Count, Toggle Save, Get Save Status, Get Saved Posts.\nOnly success (200/201) test cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get All Posts",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[Get All Posts] Fetching posts page 1');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has posts data', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body).to.have.property('data');",
                  "});",
                  "",
                  "// Save first post ID for subsequent tests",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length > 0) {",
                  "    pm.environment.set('test_post_id', body.data[0].id);",
                  "    console.log('[Get All Posts] Saved test_post_id:', body.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/posts?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Posts By User ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[Get Posts By User] userId:', pm.environment.get('user_id'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has posts data', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body).to.have.property('data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/posts/user/{{user_id}}?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "posts", "user", "{{user_id}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Create Post (Text Only)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["console.log('[Create Post] Creating text post');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has post data', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body).to.have.property('post');",
                  "    pm.expect(body.post).to.have.property('id');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.post && body.post.id) {",
                  "    pm.environment.set('created_post_id', body.post.id);",
                  "    console.log('[Create Post] Saved created_post_id:', body.post.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "content",
                  "value": "This is a test post from Postman {{$timestamp}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/posts",
              "host": ["{{base_url}}"],
              "path": ["api", "posts"]
            }
          }
        },
