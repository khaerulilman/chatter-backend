            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "content",
                  "value": "Post with media from Postman {{$timestamp}}",
                  "type": "text"
                },
                { "key": "media", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/posts",
              "host": ["{{base_url}}"],
              "path": ["api", "posts"]
            }
          }
        },
        {
          "name": "Get Post By ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const postId = pm.environment.get('created_post_id') || pm.environment.get('test_post_id');",
                  "console.log('[Get Post By ID] postId:', postId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has post data', function () {",
