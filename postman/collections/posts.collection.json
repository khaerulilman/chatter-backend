          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/posts/{{created_post_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "posts", "{{created_post_id}}"]
            }
          }
        },
        {
          "name": "Delete Post",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[Delete Post] Deleting postId:', pm.environment.get('created_post_id'));"
