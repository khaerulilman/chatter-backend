{
  "info": {
    "_postman_id": "chatter-follows-collection",
    "name": "Chatter - Follows API",
    "description": "Follows endpoints: Toggle Follow, Get Follow Status, Get Followers, Get Following, Get Follow Stats, Get Recommended Users, Get Following IDs.\nOnly success (200) test cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Toggle Follow",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[Toggle Follow] target_user_id:', pm.environment.get('target_user_id'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has follow data', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('message');",
              "    pm.expect(body).to.have.property('following');",
              "    pm.expect(body).to.have.property('followerCount');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{auth_token}}", "type": "string" }
          ]
        },
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/follows/{{target_user_id}}/toggle",
          "host": ["{{base_url}}"],
          "path": ["api", "follows", "{{target_user_id}}", "toggle"]
        }
      }
    },
